# Local Compose uses PostgreSQL and Redis. Do not commit real credentials.
POSTGRES_DB=agentops
POSTGRES_USER=agentops
POSTGRES_PASSWORD=agentops-local-only-change-this
DATABASE_URL=postgresql+psycopg://agentops:agentops-local-only-change-this@postgres:5432/agentops
REDIS_URL=redis://redis:6379/0
QUEUE_MODE=celery
SECRET_KEY=replace-with-a-random-32-byte-or-longer-secret
AGENTOPS_DEMO_MODE=false
ENVIRONMENT=development
GROQ_API_KEY=
GEMINI_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-2.0-flash
COST_PER_1K_INPUT_TOKENS=0.0002
COST_PER_1K_OUTPUT_TOKENS=0.0008
CORS_ORIGINS=http://localhost:3000

# For direct local API development outside Compose, use a local PostgreSQL DSN:
# DATABASE_URL=postgresql+psycopg://agentops:agentops@localhost:5432/agentops
# For an explicitly ephemeral hosted preview without PostgreSQL, set AGENTOPS_DEMO_MODE=true.
